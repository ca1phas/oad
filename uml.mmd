        + showUserNotFound() void
        + showIncorrectPassword() void
        + showLoginSuccess(User user) void
        + displayLoginFailed() void
        + showSignupHeader() void
        + promptConfirmPassword() String
        + promptConfirmPassword(String message) String
        + showPasswordMismatch() void
