    class App {
        + main(String[] args) void
        - startUserSession(User currentUser, Scanner sc, UserController userController, BookController bookController, ReservationController reservationController) void
    }

    class DateTimeUtil {
        <<utility>>
        + static DATE_FORMAT : DateTimeFormatter
        + static DATETIME_FORMAT : DateTimeFormatter
        + static parseDate(String str) LocalDate
        + static parseDateTime(String str) LocalDateTime
        + static formatDate(LocalDate date) String
        + static formatDateTime(LocalDateTime dateTime) String
    }
    class FileHandlerUtil {
        <<utility>>
        - static DELIMITER : String
        - static SEPERATOR : String
        + static readData(String filePath) List~List~String~~
        + static readHeader(String filePath) String
        + static writeData(String filePath, String header, List~List~String~~) void
        + static appendDataRow(String filePath, List~String~ row) void
        + static clearFile(String filePath, String header) void
        + static updateDataRow(String filePath, int rowIndex, List~String~ newRow) void
        + static deleteDataRow(String filePath, int rowIndex) void
    }
    class IDGeneratorUtil {
        <<utility>>
        + static generateId(String filePath) int
    }
    class PaginationUtil~T~ {
        <<utility>>
        + static paginate(List~T~ items, int pageNumber, int pageSize) List~T~
        + static getTotalPages(int totalItems, int pageSize) int
        + static validatePageNumber(int requestedPage, int totalItems, int pageSize) int
    }

