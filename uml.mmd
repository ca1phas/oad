        - handleReserveBook(User) void
    }
    class UserController {
        - Scanner sc
        - UserService userService
        - UserView userView
        + UserController(Scanner)
        + handleAccountMenu(User) void
        + handleUserManagementMenu(User) void
        + handleUserDetailView(User) void
        + handleUpdateUsername(User) void
        + handleUpdatePassword(User) void
        + handleDeleteUser(User, User) boolean
        + handleUpdateRole(User, User) void
        + handleAdminCreateUser(User) void
        + handleViewByPage() void
        + handleFilterAndSort() void
        - handleViewUserDetails(User) void
        - handleUserPagination(List~User~) void
    }

    class AuthView {
