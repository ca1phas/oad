        + String endStart
        + String endEnd
        + SortFilterOptions(String sortBy, boolean ascending, String idFilter, String usernameFilter, String bookTitleFilter, String statusFilter, String resStart, String resEnd, String startStart, String startEnd, String endStart, String endEnd)
    }
    class UserView {
        - Scanner sc
        + UserView(Scanner sc)
        + displayAccountMenu(User user) void
        + displayUserManagementMenu() void
        + displayUserDetailMenu(User user) void
