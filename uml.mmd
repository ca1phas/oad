---
config:
  layout: elk
---
classDiagram
    direction LR
    class Identifiable {
        <<interface>>
        + getKey() String
    }
    class Book {
        - id : int
        - title : String
        - author : String
        - genre : String
        - releasedDate : LocalDate
        - filename : String
        + Book(int, String, String, String, LocalDate, String)
        + getId() int
        + getTitle() String
        + getAuthor() String
        + getGenre() String
        + getReleasedDate() LocalDate
        + getFilename() String
        + setTitle(String) void
        + setAuthor(String) void
        + setGenre(String) void
        + setReleasedDate(LocalDate) void
        + setFilename(String) void
        + toString() String
        + getKey() String
    }
    class User {
        - id : int
        - username : String
        - password : String
        - role : UserRole
        + User(int, String, String, UserRole)
        + getId() int
        + getUsername() String
        + getPassword() String
        + getRole() UserRole
        + setUsername(String) void
        + setPassword(String) void
        + setRole(UserRole) void
        + isAdmin() boolean
        + toString() String
        + getKey() String
    }
    class Reservation {
        - id : int
        - book : Book
        - username : String
        - reservationDate : LocalDateTime
        - status : ReservationStatus
        - startDate : LocalDate
        - endDate : LocalDate
        + Reservation(int, Book, String, LocalDateTime, ReservationStatus, LocalDate, LocalDate)
        + getId() int
        + getBook() Book
        + getUsername() String
        + getReservationDate() LocalDateTime
        + getStatus() ReservationStatus
        + getStartDate() LocalDate
        + getEndDate() LocalDate
        + setStatus(ReservationStatus) void
        + setStartDate(LocalDate) void
        + setEndDate(LocalDate) void
        + toString() String
        + getKey() String
    }
    class ReservationStatus {
        <<enum>>
        PENDING
        APPROVED
        DENIED
        CANCELLED
        ACTIVE
        EXPIRED
        RETURNED
        + fromString(String) ReservationStatus
        + toString() String
    }
    class UserRole {
        <<enum>>
        ADMIN
        MEMBER
        + fromString(String) UserRole
        + toString() String
    }

    class BaseRepository~T extends Identifiable~ {
        - filePath : String
        - header : String
        + BaseRepository(String, String)
        + getFilePath() String
        + getHeader() String
        + readAll() List<T>
        + saveAll(List<T>) void
        + append(T) void
        + update(Predicate<T>, T) boolean
        + delete(Predicate<T>) boolean
        + findByKey(String) Optional<T>
        + updateByKey(T) boolean
        + deleteByKey(String) boolean
        # mapToModel(List<String>) T
        # mapFromModel(T) List<String>
    }
    class BookRepository {
        + BookRepository()
        + findById(int) Optional<Book>
        + update(Book) boolean
        + delete(int) boolean
        # mapToModel(List<String>) Book
        # mapFromModel(Book) List<String>
    }
    class UserRepository {
        + UserRepository()
        + findByUsername(String) Optional<User>
        + update(User) boolean
        + delete(String) boolean
        # mapToModel(List<String>) User
        # mapFromModel(User) List<String>
    }
    class ReservationRepository {
        - bookRepository : BookRepository
        + ReservationRepository()
        + findById(int) Optional<Reservation>
        + update(Reservation) boolean
        + delete(int) boolean
        # mapToModel(List<String>) Reservation
        # mapFromModel(Reservation) List<String>
    }
    
    class BookService {
        - BookRepository bookRepository
        - static int PAGE_SIZE = 20
        + BookService()
        + addBook(String, String, String, LocalDate, String) boolean
        + viewBook(int) Optional~Book~
        + readBook(String, int, boolean) List~String~
        + updateTitle(int, String, boolean) boolean
        + updateAuthor(int, String, boolean) boolean
        + updateGenre(int, String, boolean) boolean
        + updateReleaseDate(int, LocalDate, boolean) boolean
        + updateFilename(int, String, boolean) boolean
        + deleteBook(int, boolean) boolean
        + filterSortPaginateBooks(String, String, String, String, LocalDate, LocalDate, String, boolean, int, int) List~Book~
        + hasNextPage(String, int) boolean
    }
    class UserService {
        - UserRepository userRepository
        + UserService()
        + usernameExists(String) boolean
        + signup(String, String, String) boolean
        + login(String, String) Optional~User~
        + findByUsername(String) Optional~User~
        + updateUsername(String, String, boolean, String) boolean
        + updatePassword(String, String, String, String, boolean, String) boolean
        + updateRole(String, UserRole, boolean) boolean
        + deleteUser(String, boolean, String) boolean
        + createUser(String, String, String, UserRole, boolean) boolean
        + filterSortPaginateUsers(String, UserRole, String, boolean, int, int) List~User~
    }
    class ReservationService {
        - ReservationRepository reservationRepository
        + ReservationService()
        + hasValidReservation(String, int) boolean
        + updateReservationStatusesOnStartup() void
        + reserveBook(Book, String, LocalDate, LocalDate) boolean
        + filterSortPaginate(String, boolean, String, String, String, ReservationStatus, LocalDate, LocalDate, LocalDate, LocalDate, LocalDate, LocalDate, String, boolean, int, int) List~Reservation~
        + selectReservation(int, String, boolean) Optional~Reservation~
        + updateStatus(int, String, boolean, ReservationStatus) boolean
        + updateStartDate(int, String, boolean, LocalDate) boolean
        + updateEndDate(int, String, boolean, LocalDate) boolean
        + deleteReservation(int, boolean) boolean
    }

    class AuthController {
        - UserService userService
        - AuthView authView
        - User currentUser
        + AuthController(Scanner)
        + getCurrentUser() User
        + handleSignup() Optional~User~
        + handleLogin() Optional~User~
        + createUser(String, String, String, String) boolean
    }
    class BookController {
        - BookService bookService
        - BookView bookView
        - ReservationService reservationService
        - String
        - String
        - String
        + BookController(Scanner)
        + handleMenu(boolean, boolean, User) void
        - handleListBooksByPage(boolean, boolean) void
        - handleFilterBooks(boolean, boolean) void
        - isValidSortField(String) boolean
        - handleViewBookDetails(boolean, boolean, User) void
        - handleBookSubMenu(Book, boolean, boolean, User) void
        - handleAddBook() void
        - handleUpdateBook(int) void
        - handleDeleteBook(int) boolean
        - handleReadBook(Book) void
        - reserveBook(User, int) void
        - parseDate(String) LocalDate
        - isValidFilename(String) boolean
    }
    class ReservationController {
        - ReservationService reservationService
        - BookService bookService
        - ReservationsView view
        - BookView bookView
        - String sortField
        - boolean ascending
        - String idFilter
        - String usernameFilter
        - String bookTitleFilter
        - String statusFilter
        - LocalDate resStart
        - LocalDate resEnd
        - LocalDate startStart
        - LocalDate startEnd
        - LocalDate endStart
        - LocalDate endEnd
        + ReservationController(ReservationService, BookService, ReservationsView, BookView)
        + handleReservationsMenu(User) void
        - handlePaginatedReservations(User, boolean) void
