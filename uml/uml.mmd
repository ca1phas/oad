	    + setEndDate(LocalDate) void
	    + toString() String
	    + getKey() String
    }
    class ReservationStatus {
	    PENDING
	    APPROVED
	    DENIED
	    CANCELLED
	    ACTIVE
	    EXPIRED
	    RETURNED
	    + fromString(String) ReservationStatus
	    + toString() String
    }
    class UserRole {
